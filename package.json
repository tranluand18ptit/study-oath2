{
  "name": "oauth-study-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "bash ./scripts/start-all.sh",
    "dev": "bash ./scripts/dev-all.sh",
    "start:auth": "cd auth-server && npm start",
    "start:resource": "cd resource-server && npm start",
    "start:frontend": "cd frontend && npm start",
    "dev:auth": "cd auth-server && npm run dev",
    "dev:resource": "cd resource-server && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "install:all": "cd auth-server && npm install && cd ../resource-server && npm install && cd ../frontend && npm install"
  }
}
